# Railway 環境変数テンプレート
# このファイルを参考に、Railway Dashboard で環境変数を設定してください

# ============================================
# PostgreSQL（自動設定 - 手動設定不要）
# ============================================
# Railway が自動的に以下の環境変数を設定します：
# - PGHOST
# - PGPORT
# - PGUSER
# - PGPASSWORD
# - PGDATABASE
# - DATABASE_URL

# ============================================
# バックエンド環境変数
# ============================================

# データベース設定（PostgreSQL サービスの環境変数から取得）
# [PGHOST], [PGPORT], [PGDATABASE] などを実際の値に置き換えてください
SPRING_DATASOURCE_URL=jdbc:postgresql://[PGHOST]:[PGPORT]/[PGDATABASE]?connectTimeout=10&socketTimeout=30
SPRING_DATASOURCE_USERNAME=[PGUSER]
SPRING_DATASOURCE_PASSWORD=[PGPASSWORD]

# JWT設定（本番環境では強力な秘密鍵を使用）
# 32文字以上のランダムな文字列を生成してください
JWT_SECRET=your-very-long-and-secure-secret-key-change-this-in-production-minimum-32-characters

# サーバー設定
SERVER_PORT=8080

# CORS設定（フロントエンドの公開URLを設定）
# フロントエンドの公開URLが確定したら、この値を更新してください
# 例: CORS_ALLOWED_ORIGINS=https://frontend-production.up.railway.app
CORS_ALLOWED_ORIGINS=https://*.railway.app

# データベース自動初期化
SPRING_SQL_INIT_MODE=always
APP_DATABASE_AUTO_INIT=true

# セキュリティ設定（本番環境では変更してください）
SPRING_SECURITY_USER_NAME=admin
SPRING_SECURITY_USER_PASSWORD=admin

# ログ設定
LOGGING_LEVEL_COM_BANKING_INTERNETBANKING=INFO
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_SECURITY=INFO

# ============================================
# フロントエンド環境変数
# ============================================

# バックエンドAPIのURL（バックエンドの公開URLを設定）
# バックエンドの公開URLが確定したら、この値を更新してください
# 例: REACT_APP_API_URL=https://backend-production.up.railway.app/api
REACT_APP_API_URL=https://[backend-service-name].railway.app/api

# モックAPIを無効化
REACT_APP_USE_MOCK_API=false

# ============================================
# 環境変数の設定方法
# ============================================
# 1. Railway Dashboard にログイン
# 2. プロジェクトを選択
# 3. サービス（バックエンドまたはフロントエンド）を選択
# 4. 「Variables」タブを開く
# 5. 「+ New Variable」をクリック
# 6. 変数名と値を入力
# 7. 「Add」をクリック
# 8. サービスを再デプロイ（自動的に再デプロイされる場合もあります）
